{% extends 'base.html.twig' %}

{% block title %}Mes inscriptions{% endblock %}

{% block body %}
    <div class="section-head">
        <div>
            <h1>Mes inscriptions</h1>
            <p class="muted">Vous êtes inscrit à {{ events|length }} événement(s).</p>
        </div>
    </div>

    {% if events is not empty %}
        <ul class="event-list">
            {% for event in events %}
                <li class="event-card cat-{{ event.category }}">
                    <div class="event-media">
                        {% if event.image %}
                            <img class="event-image" src="{{ asset('uploads/' ~ event.image) }}" alt="{{ event.title }}">
                        {% else %}
                            <img class="event-image" src="{{ asset('images/' ~ event.category ~ '.jpg') }}" alt="">
                        {% endif %}
                        <div class="event-date">
                            <span class="day">{{ event.date|date('d') }}</span>
                            <span class="month">{{ event.date|date('M') }}.</span>
                        </div>
                        <span class="badge">{{ event.category|capitalize }}</span>
                    </div>
                    <h3 class="event-title"><a href="{{ path('app_event_show', {id: event.id}) }}">{{ event.title }}</a></h3>
                    <span class="muted">{{ event.date|date('d/m/Y · H\\hi') }}</span>
                    <form method="post" action="{{ path('app_event_unregister', {id: event.id}) }}">
                        <button type="submit" class="btn btn-small btn-secondary">Se désinscrire</button>
                    </form>
                </li>
            {% endfor %}
        </ul>
    {% else %}
        <p class="empty">Vous n'êtes inscrit à aucun événement pour le moment.</p>
    {% endif %}
{% endblock %}