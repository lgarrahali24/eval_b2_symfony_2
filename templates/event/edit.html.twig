{% extends 'base.html.twig' %}

{# Évaluation 2 – page de modification : réutilisez le formulaire EventType (même formulaire que l'ajout) #}

{% block title %}Modifier l'événement{% endblock %}

{% block body %}
    <div class="narrow">
        <a class="back-link" href="{{ path('app_event_show', {id: event.id}) }}">← Retour à l'événement</a>

        <div class="card">
            <h1>Modifier l'événement</h1>

            {{ form_start(form) }}
                {{ form_widget(form) }}
                <button type="submit" class="btn">Enregistrer l'événement</button>
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
